# Fill in only this value. Never commit your real key.
GEMINI_API_KEY=
AGENT_MAX_STEPS=3
AGENT_MAX_TOKENS=16000
AGENT_MAX_COST_USD=0.16
AGENT_TOKEN_PRICE_CEILING_USD=10
TOOL_TIMEOUT_SECONDS=10

# Local database defaults. Compose replaces localhost with its db service hostname.
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind

# Gemini embeddings. The model and dimensions must match the database migration.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Chunk sizes count lexical tokens; supported sizes are 300 and 800.
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# Small-document limits. Upload bytes below equal 10 MB.
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MAX_EXTRACTED_CHARACTERS=500000
MAX_CHUNKS=200

# Answer generation and retrieval defaults. No additional credentials are needed.
LLM_PRIMARY_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.8-flash
LLM_MAX_OUTPUT_TOKENS=1024
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_CANDIDATES=12
CONTEXT_TOP_N=5
SIMILARITY_THRESHOLD=0.45
REQUEST_TIMEOUT_SECONDS=120
